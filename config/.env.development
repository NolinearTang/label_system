# 开发环境配置
ENV=development

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=dev_password
MYSQL_DATABASE=label_system_dev
MYSQL_CHARSET=utf8mb4

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=true

# Redis Key前缀
REDIS_KEY_PREFIX=label_system:dev

# 定时任务配置（秒）- 开发环境1分钟同步一次
SYNC_INTERVAL_SECONDS=60
