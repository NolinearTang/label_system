# 环境配置示例文件
# 复制此文件为 .env.development, .env.test, .env.production 等并修改相应配置

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=label_system
MYSQL_CHARSET=utf8mb4

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=true

# 定时任务配置（秒）
SYNC_INTERVAL_SECONDS=300
