# 测试环境配置
ENV=test

# MySQL数据库配置
MYSQL_HOST=test-db.example.com
MYSQL_PORT=3306
MYSQL_USER=test_user
MYSQL_PASSWORD=test_password
MYSQL_DATABASE=label_system_test
MYSQL_CHARSET=utf8mb4

# Redis配置
REDIS_HOST=test-redis.example.com
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=test_redis_password
REDIS_DECODE_RESPONSES=true

# Redis Key前缀
REDIS_KEY_PREFIX=label_system:test

# 定时任务配置（秒）- 测试环境3分钟同步一次
SYNC_INTERVAL_SECONDS=180

# Embedding服务配置
EMBEDDING_URL=http://localhost:8080/embed
RERANK_URL=http://localhost:8081/rerank
